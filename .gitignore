# dependencies
node_modules/
.pnpm-store/

# build output
dist/
.output/
.vercel/
.netlify/

# astro
.astro/

# env & secrets — never in the index
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.p12
*.key.json
service-account*.json

# agent-local settings (per machine): permissions, allowlists
**/.claude/settings.local.json

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# python: uv workspace at the repo root (labs/*), see pyproject.toml
.venv/
.ruff_cache/
__pycache__/

# SQLite databases and their side files — personal data never enters git
# (guard.yml fails a push that tracks one)
*.db
*.db-wal
*.db-shm
*.db-journal
*.db.partial
apps/almanac/backups/

# os / editor
.DS_Store
*.local
.idea/
.vscode/*
!.vscode/extensions.json

.playwright-mcp

# private workspace — the only place for anything not meant to be public.
# Résumés (with contacts), raw drafts, strategy, project notes. See workspace/README.md.
workspace/private/

delete*