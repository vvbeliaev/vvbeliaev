# Окружение приложения `almanac` в Coolify (проект `almanac`, production) — полный контракт.
# Применяется скриптом контура: `coolify-env-sync.py --app <uuid приложения> --file <этот файл>`;
# ключей, которых здесь нет, в приложении не будет.
#
# Секретов здесь нет: значения лежат в общих переменных окружения production проекта
# `almanac`, сюда попадает только ссылка. Адрес базы пишет `pg-app-db.sh` на сервере,
# остальное заливается из локального `.env` (`coolify-shared-push.py`).

DATABASE_URL={{environment.DATABASE_URL}}
OWNER_PASSWORD_HASH={{environment.OWNER_PASSWORD_HASH}}
OWNER_TZ={{environment.OWNER_TZ}}

# Публичный адрес: от него строятся адреса OAuth и с ним сверяется Origin формы входа.
BASE_URL=https://almanac.vvbeliaev.dev

# Бот Telegram: напоминания и приём сообщений владельца во «Входящие». Опрашивать бота может
# только один процесс: тот же токен в локальном `.env` дал бы отказ Telegram и двойные напоминания.
TELEGRAM_BOT_TOKEN={{environment.TELEGRAM_BOT_TOKEN}}
TELEGRAM_OWNER_CHAT_ID={{environment.TELEGRAM_OWNER_CHAT_ID}}

# Собеседник в Telegram: кто отвечает и насколько глубоко думает — цепочка в ASSISTANT_MODEL (`llm.py`).
# Первая модель основная, следующая подхватывает, когда API отказал. Модель и глубина выбраны замером
# `tests/bench_live.py`: 13 сценариев по 10 повторов, 130 из 130. Без единого ключа модели бот только
# записывает во «Входящие».
ASSISTANT_MODEL=anthropic:claude-haiku-5-5@high,google:gemini-3.8-flash
# Claude — через шлюз к моделям контура cogisoft: agentgateway на той же площадке, в той же сети докера
# (cogisoft, infra/agentgateway). Поэтому ANTHROPIC_API_KEY здесь — ключ almanac у шлюза, а не ключ
# Anthropic: он ограничен моделями и суточным потолком, расход виден в журнале шлюза. В общие переменные
# он приходит из проекта `infra` (`coolify-shared-push.py --from-project infra
# ANTHROPIC_API_KEY=AGW_KEY_ALMANAC`). Адрес читает сам SDK Anthropic; убрать строку — almanac снова идёт
# к Anthropic напрямую, и тогда ключ нужен настоящий.
ANTHROPIC_BASE_URL=http://agentgateway:4000
ANTHROPIC_API_KEY={{environment.ANTHROPIC_API_KEY}}
# Ключ Google Gemini под прежним именем (новое — GOOGLE_API_KEY, читаются оба).
LLM_API_KEY={{environment.LLM_API_KEY}}

# Позже, когда понадобится (сначала общая переменная, потом строка здесь):
# ICS_TOKEN={{environment.ICS_TOKEN}}
