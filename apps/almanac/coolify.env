# Окружение приложения `almanac` в Coolify (проект `almanac`, production) — полный контракт.
# Применяется скриптом контура: `coolify-env-sync.py --app <uuid приложения> --file <этот файл>`;
# ключей, которых здесь нет, в приложении не будет.
#
# Секретов здесь нет: значения лежат в общих переменных окружения production проекта
# `almanac`, сюда попадает только ссылка. Адрес базы пишет `pg-app-db.sh` на сервере,
# остальное заливается из локального `.env` (`coolify-shared-push.py`).

DATABASE_URL={{environment.DATABASE_URL}}
OWNER_PASSWORD_HASH={{environment.OWNER_PASSWORD_HASH}}
OWNER_TZ={{environment.OWNER_TZ}}

# Публичный адрес: от него строятся адреса OAuth и с ним сверяется Origin формы входа.
BASE_URL=https://almanac.vvbeliaev.dev

# Позже, когда понадобятся (сначала общая переменная, потом строка здесь):
# TELEGRAM_BOT_TOKEN={{environment.TELEGRAM_BOT_TOKEN}}
# TELEGRAM_OWNER_CHAT_ID={{environment.TELEGRAM_OWNER_CHAT_ID}}
# ICS_TOKEN={{environment.ICS_TOKEN}}
