---
/*
  Work.astro — selected work as field-log entries: full-width rows, stacked.
  On wide screens each entry is two columns — role + name on the left, the
  description + highlights on the right — so two entries read as a log, not as
  two competing CTAs. Coral rim stays quiet; the ember glow appears on hover
  only (DESIGN.md: glow is a focused source, not an ambient wash). The first
  entry carries the LED — it's the current one.
*/
import { PROJECTS } from "$lib/config";
import { getLangFromUrl, useTranslations } from "$i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const featured = PROJECTS.filter((p) => p.featured);
const others = PROJECTS.filter((p) => !p.featured);
---

<section class="mt-14">
  <h2 class="font-mono text-xs uppercase tracking-[0.3em] text-muted-foreground">
    {t("home.work")}
  </h2>

  <ul class="mt-4 space-y-3">
    {
      featured.map((p, i) => {
        // "Role · Domain" → two lines: the role in coral, the domain quiet.
        const [role, domain] = p.tag.split(" · ");
        return (
        <li>
          <a
            href={p.href}
            target="_blank"
            rel="noopener noreferrer"
            class="work-entry group block rounded-xl border border-primary/30 bg-card/60 p-5 transition-[border-color,box-shadow] duration-300 hover:border-primary sm:p-6"
          >
            <div class="grid gap-4 sm:grid-cols-[minmax(0,16rem)_1fr] sm:gap-8">
              <div class="min-w-0">
                <span class="flex items-start gap-2 font-mono text-[11px] uppercase leading-relaxed tracking-[0.2em]">
                  {i === 0 && <span class="led-indicator mt-[0.45em] shrink-0 text-primary" aria-hidden="true" />}
                  <span class="flex flex-col">
                    <span class="text-primary">{role}</span>
                    {domain && <span class="text-muted-foreground">{domain}</span>}
                  </span>
                </span>
                <h3 class="mt-2 font-display text-2xl font-bold tracking-tight">{p.name}</h3>
              </div>

              <div class="relative min-w-0 sm:pr-6">
                <p class="text-muted-foreground">{p.description}</p>
                {p.highlights && (
                  <ul class="mt-3 flex flex-wrap gap-2">
                    {p.highlights.map((h) => (
                      <li class="rounded-full border border-border bg-background/40 px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
                        {h}
                      </li>
                    ))}
                  </ul>
                )}
                <span
                  class="absolute top-0 right-0 hidden text-muted-foreground transition-colors group-hover:text-primary sm:block"
                  aria-hidden="true"
                >
                  ↗
                </span>
              </div>
            </div>
          </a>
        </li>
        );
      })
    }
  </ul>

  {
    others.length > 0 && (
      <ul class="mt-3 space-y-3">
        {others.map((p) => (
          <li>
            <a
              href={p.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-baseline justify-between gap-4 rounded-lg border border-border bg-card/40 p-4 transition-colors hover:border-primary/40 hover:bg-card"
            >
              <div class="min-w-0">
                <span class="font-display font-semibold tracking-tight">{p.name}</span>
                <span class="ml-2 font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
                  {p.tag}
                </span>
                <p class="mt-1 text-sm text-muted-foreground">{p.description}</p>
              </div>
              <span class="shrink-0 text-muted-foreground transition-colors group-hover:text-primary">
                ↗
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>

<style>
  /* Ember on hover only: the same glow token as the primary CTA, gated. */
  .work-entry:hover,
  .work-entry:focus-visible {
    box-shadow: 0 0 var(--glow-blur, 24px) var(--glow-spread, -6px)
      color-mix(in oklch, var(--primary) 55%, transparent);
  }
</style>
