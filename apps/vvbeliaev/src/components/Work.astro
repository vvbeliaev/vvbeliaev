---
/*
  Work.astro — selected work as field-log entries, split by `kind`: employment
  ("Roles") and own ventures ("Own projects"). The split is the point — a hiring
  reader must be able to tell a job from a side venture without guessing, and the
  tag alone never carried that.

  Within a group, `featured` entries get the two-column accent log row; the rest
  fall into the compact list. Coral rim stays quiet; the ember glow appears on
  hover only (DESIGN.md: glow is a focused source, not an ambient wash). The LED
  marks the current role — the first featured entry under "Roles".
*/
import { PROJECTS } from "$lib/config";
import { getLangFromUrl, useTranslations } from "$i18n/utils";
import type { UIKey } from "$i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const GROUPS: ReadonlyArray<{ kind: "role" | "own"; heading: UIKey }> = [
  { kind: "role", heading: "home.roles" },
  { kind: "own", heading: "home.own" },
];

const groups = GROUPS.map((g) => {
  const items = PROJECTS.filter((p) => p.kind === g.kind);
  return {
    ...g,
    featured: items.filter((p) => p.featured),
    rest: items.filter((p) => !p.featured),
  };
}).filter((g) => g.featured.length + g.rest.length > 0);
---

{
  groups.map((group) => (
    <section class="mt-14">
      <h2 class="font-mono text-xs uppercase tracking-[0.3em] text-muted-foreground">
        {t(group.heading)}
      </h2>

      {group.featured.length > 0 && (
        <ul class="mt-4 space-y-3">
          {group.featured.map((p, i) => {
            // "Role · Domain" → two lines: the role in coral, the domain quiet.
            const [role, domain] = p.tag[lang].split(" · ");
            return (
              <li>
                <a
                  href={p.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="work-entry group block rounded-xl border border-primary/30 bg-card/60 p-5 transition-[border-color,box-shadow] duration-300 hover:border-primary sm:p-6"
                >
                  <div class="grid gap-4 sm:grid-cols-[minmax(0,16rem)_1fr] sm:gap-8">
                    <div class="min-w-0">
                      <span class="flex items-start gap-2 font-mono text-[11px] uppercase leading-relaxed tracking-[0.2em]">
                        {group.kind === "role" && i === 0 && (
                          <span
                            class="led-indicator mt-[0.45em] shrink-0 text-primary"
                            aria-hidden="true"
                          />
                        )}
                        <span class="flex flex-col">
                          <span class="text-primary">{role}</span>
                          {domain && <span class="text-muted-foreground">{domain}</span>}
                        </span>
                      </span>
                      <h3 class="mt-2 font-display text-2xl font-bold tracking-tight">
                        {p.name}
                      </h3>
                    </div>

                    <div class="relative min-w-0 sm:pr-6">
                      <p class="text-muted-foreground">{p.description[lang]}</p>
                      {p.highlights && (
                        <ul class="mt-3 flex flex-wrap gap-2">
                          {p.highlights.map((h) => (
                            <li class="rounded-full border border-border bg-background/40 px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
                              {h[lang]}
                            </li>
                          ))}
                        </ul>
                      )}
                      <span
                        class="absolute top-0 right-0 hidden text-muted-foreground transition-colors group-hover:text-primary sm:block"
                        aria-hidden="true"
                      >
                        ↗
                      </span>
                    </div>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      )}

      {group.rest.length > 0 && (
        <ul class="mt-3 space-y-3">
          {group.rest.map((p) => (
            <li>
              <a
                href={p.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-baseline justify-between gap-4 rounded-lg border border-border bg-card/40 p-4 transition-colors hover:border-primary/40 hover:bg-card"
              >
                <div class="min-w-0">
                  <span class="font-display font-semibold tracking-tight">{p.name}</span>
                  <span class="ml-2 font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
                    {p.tag[lang]}
                  </span>
                  <p class="mt-1 text-sm text-muted-foreground">{p.description[lang]}</p>
                </div>
                <span class="shrink-0 text-muted-foreground transition-colors group-hover:text-primary">
                  ↗
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
  ))
}

<style>
  /* Ember on hover only: the same glow token as the primary CTA, gated. */
  .work-entry:hover,
  .work-entry:focus-visible {
    box-shadow: 0 0 var(--glow-blur, 24px) var(--glow-spread, -6px)
      color-mix(in oklch, var(--primary) 55%, transparent);
  }
</style>
