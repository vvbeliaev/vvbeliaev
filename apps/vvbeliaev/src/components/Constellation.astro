---
/*
  Constellation.astro — the signature "star chart of one operator" hero.
  A large warm avatar core (the person) connected to three cool facet stars
  (Engineer / Product / Analytics). The facets are one connected constellation,
  not three separate jobs — that's the persona, packaged.

  The center is an avatar disc: pass `avatar` (image URL) to render the real
  photo; without it, a monogram placeholder is shown.

  "Corona Bloom", literally: on load the chart blooms once — the core ignites,
  links draw out from it, facet stars and names appear, captions peek for a
  moment (so mobile readers see them too), then the name. Afterwards a faint
  pointer parallax gives the chart depth (fine pointers only). Reduced motion →
  the final frame, no animation.

  Copy (facet names/captions, subtitle) is routed through src/i18n.
*/
import { SITE_I18N, OPEN_TO_WORK, CONTACT_HREF } from "$lib/config";
import { getLangFromUrl, useTranslations, localizePath } from "$i18n/utils";

interface Props {
  avatar?: string;
}
const { avatar } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { name, role, pitch, facts } = SITE_I18N[lang];
const aboutHref = localizePath("/about", lang);

const core = { x: 300, y: 180 };
const R = 64; // avatar radius — the person is the core, facets orbit it
const facets = [
  { x: 96, y: 70, name: t("facet.engineer.name"), caption: t("facet.engineer.caption") },
  { x: 506, y: 64, name: t("facet.product.name"), caption: t("facet.product.caption") },
  { x: 446, y: 308, name: t("facet.analytics.name"), caption: t("facet.analytics.caption") },
];

// a few ambient dim stars for depth (hand-placed so nothing crowds the labels)
const ambient = [
  [50, 40], [250, 44], [566, 150], [548, 304], [70, 256], [368, 120], [186, 312],
];
const monogram = name
  .split(" ")
  .map((w) => w[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();
---

<section class="pt-4 pb-2">
  <figure class="constellation bloom" aria-label={`${t("facet.engineer.name")}, ${t("facet.product.name")}, ${t("facet.analytics.name")}`}>
    <svg viewBox="0 0 600 360" role="img" preserveAspectRatio="xMidYMid meet">
      <defs>
        <clipPath id="avatarClip">
          <circle cx={core.x} cy={core.y} r={R} />
        </clipPath>
      </defs>

      <g class="ambient">
        {ambient.map(([x, y]) => <circle cx={x} cy={y} r="1" />)}
      </g>

      <g class="layer layer-facets">
        {
          facets.map((f, i) => (
            <g class="facet" style={`--i:${i}`}>
              <line class="facet-link" x1={core.x} y1={core.y} x2={f.x} y2={f.y} />
              <line class="base-link" pathLength="1" x1={core.x} y1={core.y} x2={f.x} y2={f.y} />
              <circle class="facet-star" cx={f.x} cy={f.y} r="4" />
              <text class="facet-name" x={f.x} y={f.y - 14} text-anchor="middle">
                {f.name}
              </text>
              <text class="facet-cap" x={f.x} y={f.y + 22} text-anchor="middle">
                {f.caption}
              </text>
            </g>
          ))
        }
      </g>

      <g class="layer layer-core">
      <circle class="core-halo" cx={core.x} cy={core.y} r={R + 18} />
      {
        avatar ? (
          <>
            <image
              class="avatar-img"
              href={avatar}
              x={core.x - R}
              y={core.y - R}
              width={R * 2}
              height={R * 2}
              clip-path="url(#avatarClip)"
              preserveAspectRatio="xMidYMid slice"
            />
            <circle class="avatar-tint" cx={core.x} cy={core.y} r={R} clip-path="url(#avatarClip)" />
          </>
        ) : (
          <>
            <circle class="avatar-bg" cx={core.x} cy={core.y} r={R} />
            <text class="avatar-mono" x={core.x} y={core.y} text-anchor="middle" dominant-baseline="central">
              {monogram}
            </text>
          </>
        )
      }
      <circle class="avatar-ring" cx={core.x} cy={core.y} r={R} />
      </g>
    </svg>
  </figure>

  <div class="bloom-copy mt-2 text-center">
    <h1 class="hero-name font-display text-4xl font-extrabold tracking-tight sm:text-5xl">
      {name}
    </h1>

    <p class="hero-role mt-3 font-mono text-xs uppercase tracking-[0.28em] text-primary sm:text-sm">
      {role}
    </p>

    <p class="hero-pitch mx-auto mt-5 max-w-lg text-balance leading-relaxed text-muted-foreground">
      {pitch}
    </p>

    <div class="hero-actions mt-7 flex flex-wrap items-center justify-center gap-3">
      <a
        href={CONTACT_HREF}
        target="_blank"
        rel="noopener noreferrer"
        class="cta-primary rounded-lg bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground transition-shadow duration-300"
      >
        {t("hero.cta.contact")}
      </a>
      <a
        href={aboutHref}
        class="rounded-lg border border-border bg-card/40 px-5 py-2.5 text-sm font-medium transition-colors hover:border-primary/40 hover:bg-card"
      >
        {t("hero.cta.about")}
      </a>
    </div>

    <!-- HUD readout: the line a hiring reader scans first. The LED belongs
         here because it modifies a status, not the job title. -->
    <p
      class="hero-facts mt-6 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 font-mono text-[11px] tracking-wider text-muted-foreground"
    >
      {
        OPEN_TO_WORK && (
          <>
            <span class="inline-flex items-center gap-1.5 text-primary">
              <span class="led-indicator" aria-hidden="true" />
              {t("hero.status")}
            </span>
            <span aria-hidden="true">·</span>
          </>
        )
      }
      <span>{facts}</span>
    </p>
  </div>
</section>

<style>
  .constellation svg {
    display: block;
    width: 100%;
    max-width: 640px;
    height: auto;
    margin: 0 auto;
    overflow: visible;
  }

  .ambient circle {
    fill: #d8e0f5;
    opacity: 0.28;
  }

  /* base links sit faint behind everything */
  .base-link {
    stroke: color-mix(in oklch, var(--primary) 45%, transparent);
    stroke-width: 0.6;
    opacity: 0.4;
  }

  .facet-link {
    stroke: var(--accent);
    stroke-width: 1;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .facet-star {
    fill: var(--accent);
    transition: filter 0.3s ease;
  }

  .facet-name {
    fill: var(--foreground);
    font-family: var(--ff-display);
    font-size: 17px;
    font-weight: 600;
  }

  .facet-cap {
    fill: var(--muted-foreground);
    font-family: var(--ff-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  /* hover/focus a facet → brighten its star, reveal its link + caption */
  .facet:hover .facet-star,
  .facet:focus-within .facet-star {
    filter: drop-shadow(0 0 6px var(--accent));
  }
  .facet:hover .facet-cap,
  .facet:hover .facet-link,
  .facet:focus-within .facet-cap,
  .facet:focus-within .facet-link {
    opacity: 1;
  }

  /* avatar core */
  .avatar-img {
    /* B&W portrait → settle it into the warm cosmic palette: a touch of warmth,
       slightly lifted contrast, and dimmed so the coral ring/halo stay dominant */
    filter: contrast(1.06) brightness(0.92) sepia(0.22) saturate(1.1) hue-rotate(-8deg);
  }
  .avatar-tint {
    /* coral wash, multiply-blended into the photo for cohesion with the očag */
    fill: var(--primary);
    opacity: 0.16;
    mix-blend-mode: soft-light;
  }
  .avatar-bg {
    fill: #0a0c14;
  }
  .avatar-mono {
    fill: var(--foreground);
    font-family: var(--ff-display);
    font-weight: 800;
    font-size: 30px;
    letter-spacing: 0.02em;
  }
  .avatar-ring {
    fill: none;
    stroke: var(--primary);
    stroke-width: 1.5;
    opacity: 0.95;
    filter: drop-shadow(0 0 10px var(--primary));
  }

  .core-halo {
    fill: color-mix(in oklch, var(--primary) 26%, transparent);
    animation: breathe 6s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  @keyframes breathe {
    0%,
    100% {
      opacity: 0.45;
      transform: scale(1);
    }
    50% {
      opacity: 0.8;
      transform: scale(1.18);
    }
  }

  /* ── Bloom: one orchestrated second on load ───────────────────────────── */
  .bloom .ambient circle {
    animation: appear 0.9s ease-out 0.15s both;
  }
  .bloom .layer-core {
    animation: appear 0.7s ease-out 0.25s both;
  }
  .bloom .avatar-ring {
    transform-box: fill-box;
    transform-origin: center;
    animation: ring-in 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 0.25s both;
  }
  .bloom .core-halo {
    animation:
      ignite 1.1s ease-out 0.15s both,
      breathe 6s ease-in-out 1.25s infinite;
  }
  /* links draw out from the core; stars, names, captions follow, staggered per facet */
  .bloom .base-link {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 0.7s cubic-bezier(0.4, 0, 0.2, 1) calc(0.7s + var(--i) * 0.14s) both;
  }
  .bloom .facet-star {
    animation: appear 0.4s ease-out calc(1.25s + var(--i) * 0.14s) both;
  }
  .bloom .facet-name {
    animation: rise 0.5s ease-out calc(1.35s + var(--i) * 0.14s) both;
  }
  /* captions peek once (fill-mode none → hover rule works normally afterwards) */
  .bloom .facet-cap {
    animation: peek 2.8s ease-in-out calc(1.7s + var(--i) * 0.14s) 1 normal none;
  }
  .bloom-copy .hero-name {
    animation: rise 0.7s ease-out 1.6s both;
  }
  .bloom-copy .hero-role {
    animation: rise 0.7s ease-out 1.75s both;
  }
  .bloom-copy .hero-pitch {
    animation: rise 0.7s ease-out 1.9s both;
  }
  .bloom-copy .hero-actions {
    animation: rise 0.7s ease-out 2.05s both;
  }
  .bloom-copy .hero-facts {
    animation: rise 0.7s ease-out 2.2s both;
  }

  /* Ember on hover only — the same gated glow as the Work entries. */
  .cta-primary:hover,
  .cta-primary:focus-visible {
    box-shadow: 0 0 var(--glow-blur, 24px) var(--glow-spread, -6px)
      color-mix(in oklch, var(--primary) 65%, transparent);
  }

  @keyframes appear {
    from {
      opacity: 0;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes ring-in {
    from {
      opacity: 0;
      transform: scale(0.85);
    }
  }
  @keyframes ignite {
    0% {
      opacity: 0;
      transform: scale(0.6);
    }
    55% {
      opacity: 1;
      transform: scale(1.32);
    }
    100% {
      opacity: 0.45;
      transform: scale(1);
    }
  }
  @keyframes peek {
    0%,
    100% {
      opacity: 0;
    }
    18%,
    72% {
      opacity: 1;
    }
  }

  /* ── Pointer parallax (fine pointers only, driven by --px/--py from the script) */
  .layer {
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .layer-facets {
      transform: translate(calc(var(--px, 0) * 5px), calc(var(--py, 0) * 5px));
    }
    .layer-core {
      transform: translate(calc(var(--px, 0) * 1.5px), calc(var(--py, 0) * 1.5px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .core-halo,
    .bloom .ambient circle,
    .bloom .layer-core,
    .bloom .avatar-ring,
    .bloom .base-link,
    .bloom .facet-star,
    .bloom .facet-name,
    .bloom .facet-cap,
    .bloom-copy .hero-name,
    .bloom-copy .hero-role,
    .bloom-copy .hero-pitch,
    .bloom-copy .hero-actions,
    .bloom-copy .hero-facts {
      animation: none;
    }
    .bloom .base-link {
      stroke-dashoffset: 0;
    }
    .layer {
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // Pointer parallax for the constellation: the chart tilts a few px toward
  // the pointer (facets more, core less → depth). Fine pointers only, off
  // under reduced-motion; the CSS transition smooths the follow.
  const fig = document.querySelector<HTMLElement>(".constellation");
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (fig && fine.matches && !reduce.matches) {
    let raf = 0;
    let px = 0;
    let py = 0;

    const apply = () => {
      fig.style.setProperty("--px", px.toFixed(3));
      fig.style.setProperty("--py", py.toFixed(3));
      raf = 0;
    };

    window.addEventListener(
      "pointermove",
      (e) => {
        const r = fig.getBoundingClientRect();
        // normalise to [-1, 1] around the figure centre; clamp so far-away
        // pointers don't over-tilt the chart
        px = Math.max(-1, Math.min(1, ((e.clientX - (r.left + r.width / 2)) / r.width) * 2));
        py = Math.max(-1, Math.min(1, ((e.clientY - (r.top + r.height / 2)) / r.height) * 2));
        if (!raf) raf = requestAnimationFrame(apply);
      },
      { passive: true },
    );
  }
</script>
