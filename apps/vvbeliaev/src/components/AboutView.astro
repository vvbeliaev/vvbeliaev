---
/*
  AboutView.astro — the hire-facing page: who, what, stack, how, CV.

  Deliberately unanimated and dense. The home page carries the atmosphere; this
  one carries the facts, so it reads as the HUD half of the two-layer
  construction (DESIGN.md §2) — mono labels, quiet rules, no ornament.
*/
import { SITE_I18N, STACK, CONTACT_HREF } from "$lib/config";
import { getLangFromUrl, useTranslations } from "$i18n/utils";
import type { UIKey } from "$i18n/ui";
import Channels from "./Channels.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { name, role, facts } = SITE_I18N[lang];

const DOES: ReadonlyArray<UIKey> = ["about.do.1", "about.do.2", "about.do.3", "about.do.4"];
const HOW: ReadonlyArray<UIKey> = ["about.how.1", "about.how.2", "about.how.3"];
---

<header>
  <h1 class="font-display text-4xl font-extrabold tracking-tight sm:text-5xl">
    {name}
  </h1>
  <p class="mt-3 font-mono text-xs uppercase tracking-[0.28em] text-primary sm:text-sm">
    {role}
  </p>
  <p class="mt-2 font-mono text-[11px] tracking-wider text-muted-foreground">
    {facts}
  </p>
  <p class="mt-6 max-w-2xl text-lg leading-relaxed text-foreground/85">
    {t("about.lead")}
  </p>
</header>

<section class="mt-14">
  <h2 class="font-mono text-xs uppercase tracking-[0.3em] text-muted-foreground">
    {t("about.do")}
  </h2>
  <ul class="mt-4 space-y-3">
    {
      DOES.map((key) => (
        <li class="flex gap-3 leading-relaxed">
          <span class="mt-[0.7em] h-px w-4 shrink-0 bg-primary/70" aria-hidden="true" />
          <span>{t(key)}</span>
        </li>
      ))
    }
  </ul>
</section>

<section class="mt-14">
  <h2 class="font-mono text-xs uppercase tracking-[0.3em] text-muted-foreground">
    {t("about.stack")}
  </h2>
  <dl class="mt-4 overflow-hidden rounded-lg border border-border">
    {
      STACK.map((group, i) => (
        <div
          class:list={[
            "grid gap-2 bg-card/40 px-4 py-4 sm:grid-cols-[minmax(0,10rem)_1fr] sm:gap-6",
            i > 0 && "border-t border-border",
          ]}
        >
          <dt class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">
            {group.label[lang]}
          </dt>
          <dd class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <span class="rounded-full border border-border bg-background/40 px-2.5 py-0.5 font-mono text-[11px] text-muted-foreground">
                {item}
              </span>
            ))}
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<section class="mt-14">
  <h2 class="font-mono text-xs uppercase tracking-[0.3em] text-muted-foreground">
    {t("about.how")}
  </h2>
  <ul class="mt-4 space-y-3">
    {
      HOW.map((key) => (
        <li class="flex gap-3 leading-relaxed">
          <span class="mt-[0.7em] h-px w-4 shrink-0 bg-accent/70" aria-hidden="true" />
          <span>{t(key)}</span>
        </li>
      ))
    }
  </ul>
</section>

<section class="mt-14">
  <h2 class="font-mono text-xs uppercase tracking-[0.3em] text-muted-foreground">
    {t("about.cv")}
  </h2>
  <div
    class="mt-4 flex flex-col gap-4 rounded-lg border border-primary/30 bg-card/60 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6"
  >
    <p class="max-w-lg text-muted-foreground">{t("about.cv.body")}</p>
    <a
      href={CONTACT_HREF}
      target="_blank"
      rel="noopener noreferrer"
      class="cta-primary shrink-0 self-start rounded-lg bg-primary px-5 py-2.5 text-center text-sm font-medium text-primary-foreground transition-shadow duration-300 sm:self-auto"
    >
      {t("about.cv.cta")}
    </a>
  </div>
</section>

<Channels />

<style>
  /* Ember on hover only — matches the hero CTA and the Work entries. */
  .cta-primary:hover,
  .cta-primary:focus-visible {
    box-shadow: 0 0 var(--glow-blur, 24px) var(--glow-spread, -6px)
      color-mix(in oklch, var(--primary) 65%, transparent);
  }
</style>
