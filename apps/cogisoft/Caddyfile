# Раздача статического билда Astro. TLS терминируется на Cloudflare, поэтому
# слушаем plain HTTP на 8080; Traefik в Coolify проксирует сюда.
{
	auto_https off
	admin off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Хэшированные ассеты Astro можно кэшировать вечно.
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Несуществующий путь → сайтовая 404 (apps/cogisoft/src/pages/404.astro).
	handle_errors {
		@notfound expression {err.status_code} == 404
		rewrite @notfound /404.html
		file_server
	}

	file_server
}
