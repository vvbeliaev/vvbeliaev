---
/*
  SignalField.astro — the hero's signature: a wide field of market noise
  (steel-blue ticks — dots and short dashes, like data points) out of which one
  region turns out to be dense. The pattern is expressed as CONCENTRATION, not
  direction: cluster points ignite coral from the centre outward and a warm
  halo settles under them. noise → density → evidence.

  Deliberately not a line. An earlier version drew a jagged rising polyline,
  which read as a stock chart ("number go up") — the most generic startup
  visual there is, and the opposite of the thesis. A cluster cannot be misread
  that way: there is no axis and no trend, only "here is where the demand is".

  Ongoing life after the intro: the cluster breathes, ticks pulse and flash,
  and a two-depth parallax (mouse on fine pointers + scroll drift) gives depth.

  Deterministic (seeded PRNG) so the field is stable across builds. The cluster
  sits near the viewBox centre so it survives the mobile crop
  (preserveAspectRatio slice); the mask calms the field under the hero text.
*/
function mulberry32(seed: number) {
  return function () {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const W = 1200;
const H = 700;
const rand = mulberry32(20260704);

type Tick = {
  cx: number;
  cy: number;
  r: number;
  o: number;
  dash: boolean;
  len: number;
  pulse: boolean;
  flash: boolean;
  far: boolean;
};

const ticks: Tick[] = Array.from({ length: 170 }, () => {
  const dash = rand() > 0.72;
  const roll = rand();
  return {
    cx: +(rand() * W).toFixed(1),
    cy: +(rand() * H).toFixed(1),
    r: +(0.5 + rand() * 0.9).toFixed(2),
    o: +(0.1 + rand() * 0.32).toFixed(2),
    dash,
    len: +(3 + rand() * 5).toFixed(1),
    pulse: roll > 0.6,
    flash: roll > 0.93,
    far: rand() > 0.5,
  };
});

// The cluster: the region where the noise turns out to be dense. Kept near the
// horizontal centre and above the copy so the mobile crop never loses it.
const CX = 700;
const CY = 248;
const R = 112;
const COUNT = 26;

const START = 0.6; // s before the first (centre) point ignites
const SPREAD = 1.5; // s for ignition to reach the rim

const cluster = Array.from({ length: COUNT }, () => {
  // pow > 0.5 biases radius toward the centre → density, not a ring
  const t = Math.pow(rand(), 1.6);
  const a = rand() * Math.PI * 2;
  const rr = R * t;
  return {
    x: +(CX + Math.cos(a) * rr).toFixed(1),
    // slightly flattened so it reads as a patch, not a perfect disc
    y: +(CY + Math.sin(a) * rr * 0.78).toFixed(1),
    size: +(1.5 + (1 - t) * 1.9).toFixed(2),
    delay: +(START + t * SPREAD).toFixed(2),
    core: t < 0.14,
  };
});

const HALO_AT = +(START + SPREAD + 0.15).toFixed(2);
---

<div class="signal-field" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <radialGradient id="clusterHalo">
        <stop offset="0%" stop-color="rgba(240, 138, 114, 0.28)" />
        <stop offset="55%" stop-color="rgba(240, 138, 114, 0.10)" />
        <stop offset="100%" stop-color="rgba(240, 138, 114, 0)" />
      </radialGradient>
    </defs>

    <g class="ticks" data-depth="far">
      {
        ticks
          .filter((tk) => tk.far)
          .map((tk) =>
            tk.dash ? (
              <line
                x1={tk.cx}
                y1={tk.cy}
                x2={tk.cx}
                y2={+(tk.cy + tk.len).toFixed(1)}
                class:list={["tick", { pulse: tk.pulse, flash: tk.flash }]}
                style={`--o:${tk.o};--pd:${(tk.cx % 7).toFixed(1)}s;--fd:${(tk.cy % 9).toFixed(1)}s`}
              />
            ) : (
              <circle
                cx={tk.cx}
                cy={tk.cy}
                r={tk.r}
                class:list={["tick", "dot", { pulse: tk.pulse, flash: tk.flash }]}
                style={`--o:${tk.o};--pd:${(tk.cy % 7).toFixed(1)}s;--fd:${(tk.cx % 9).toFixed(1)}s`}
              />
            ),
          )
      }
    </g>

    <g class="ticks" data-depth="near">
      {
        ticks
          .filter((tk) => !tk.far)
          .map((tk) =>
            tk.dash ? (
              <line
                x1={tk.cx}
                y1={tk.cy}
                x2={tk.cx}
                y2={+(tk.cy + tk.len).toFixed(1)}
                class:list={["tick", { pulse: tk.pulse, flash: tk.flash }]}
                style={`--o:${tk.o};--pd:${(tk.cx % 7).toFixed(1)}s;--fd:${(tk.cy % 9).toFixed(1)}s`}
              />
            ) : (
              <circle
                cx={tk.cx}
                cy={tk.cy}
                r={tk.r}
                class:list={["tick", "dot", { pulse: tk.pulse, flash: tk.flash }]}
                style={`--o:${tk.o};--pd:${(tk.cy % 7).toFixed(1)}s;--fd:${(tk.cx % 9).toFixed(1)}s`}
              />
            ),
          )
      }
    </g>

    <g class="cluster" data-depth="deep">
      <ellipse
        class="halo"
        cx={CX}
        cy={CY}
        rx={R * 1.5}
        ry={R * 1.2}
        fill="url(#clusterHalo)"
        style={`--hd:${HALO_AT}s`}
      />
      {
        cluster.map((p) => (
          <circle
            cx={p.x}
            cy={p.y}
            r={p.size}
            class:list={["signal", { core: p.core }]}
            style={`--nd:${p.delay}s`}
          />
        ))
      }
    </g>
  </svg>
</div>

<style>
  .signal-field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .signal-field svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    will-change: transform;
    /* calm the field under the hero text (bottom-left zone) */
    -webkit-mask-image: radial-gradient(60% 52% at 26% 70%, rgba(0, 0, 0, 0.22), black 74%);
    mask-image: radial-gradient(60% 52% at 26% 70%, rgba(0, 0, 0, 0.22), black 74%);
  }

  .ticks,
  .cluster {
    will-change: transform;
  }

  /* market noise */
  .tick {
    stroke: #9db8dd;
    stroke-width: 0.7;
    opacity: var(--o, 0.2);
    transform-box: fill-box;
    transform-origin: center;
  }

  .tick.dot {
    fill: #9db8dd;
    stroke: none;
  }

  .tick.pulse {
    animation: tick-pulse 5.5s ease-in-out var(--pd, 0s) infinite;
  }

  @keyframes tick-pulse {
    0%,
    100% {
      opacity: var(--o, 0.2);
    }
    50% {
      opacity: calc(var(--o, 0.2) * 0.3);
    }
  }

  /* rare bright blips — the market keeps emitting */
  .tick.flash {
    animation:
      tick-pulse 5.5s ease-in-out var(--pd, 0s) infinite,
      tick-flash 9s ease-out var(--fd, 0s) infinite;
  }

  @keyframes tick-flash {
    0%,
    88%,
    100% {
      opacity: var(--o, 0.2);
      transform: scale(1);
      filter: none;
    }
    92% {
      opacity: 1;
      transform: scale(1.9);
      filter: drop-shadow(0 0 4px rgba(157, 184, 221, 0.9));
    }
  }

  /* the confirmed region: ignites centre-out, then breathes */
  .signal {
    fill: #5f95c2;
    opacity: 0;
    animation:
      signal-ignite 0.6s ease-out var(--nd, 0s) forwards,
      signal-breathe 6s ease-in-out calc(var(--nd, 0s) + 4s) infinite;
  }

  @keyframes signal-ignite {
    0% {
      opacity: 0;
      fill: #5f95c2;
    }
    55% {
      opacity: 1;
      fill: #eef2ff;
    }
    100% {
      opacity: 0.92;
      fill: #f08a72;
    }
  }

  @keyframes signal-breathe {
    0%,
    100% {
      opacity: 0.92;
    }
    50% {
      opacity: 0.55;
    }
  }

  .signal.core {
    filter: drop-shadow(0 0 6px rgba(240, 138, 114, 0.85));
  }

  .halo {
    opacity: 0;
    animation: halo-in 1.6s ease-out var(--hd, 2s) forwards;
  }

  @keyframes halo-in {
    to {
      opacity: 1;
    }
  }

  /* static, fully-lit version for reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .tick.pulse,
    .tick.flash {
      animation: none;
    }
    .signal {
      animation: none;
      opacity: 0.92;
      fill: #f08a72;
    }
    .halo {
      animation: none;
      opacity: 1;
    }
  }
</style>

<script>
  // Two cheap parallax layers, both rAF-throttled and disabled under
  // reduced-motion: the field drifts up against the scroll, and on fine
  // pointers the tick layers shift slightly with the mouse (far moves less
  // than near — depth).
  const root = document.querySelector<HTMLElement>(".signal-field");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (root && !reduce.matches) {
    const svg = root.querySelector<SVGElement>("svg");
    const far = root.querySelector<SVGElement>('[data-depth="far"]');
    const near = root.querySelector<SVGElement>('[data-depth="near"]');
    const deep = root.querySelector<SVGElement>('[data-depth="deep"]');

    let scrollShift = 0;
    let mx = 0;
    let my = 0;
    let ticking = false;

    const apply = () => {
      if (svg) svg.style.transform = `translate3d(0, ${-scrollShift}px, 0)`;
      if (far) far.style.transform = `translate3d(${mx * -5}px, ${my * -4}px, 0)`;
      if (near) near.style.transform = `translate3d(${mx * -12}px, ${my * -9}px, 0)`;
      if (deep) deep.style.transform = `translate3d(${mx * -18}px, ${my * -13}px, 0)`;
      ticking = false;
    };

    const schedule = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(apply);
      }
    };

    window.addEventListener(
      "scroll",
      () => {
        scrollShift = Math.min((window.scrollY || 0) * 0.08, 56);
        schedule();
      },
      { passive: true },
    );

    if (window.matchMedia("(pointer: fine)").matches) {
      window.addEventListener(
        "mousemove",
        (e) => {
          mx = e.clientX / window.innerWidth - 0.5;
          my = e.clientY / window.innerHeight - 0.5;
          schedule();
        },
        { passive: true },
      );
    }

    apply();
  }
</script>
