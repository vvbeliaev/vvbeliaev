---
/*
  NotFor.astro — disqualification, said before the call. Raises trust and filters
  bad fits early, which matters more than usual when delivery capacity is thin.
*/
import Section from "./Section.astro";
import { getLangFromUrl, useTranslations } from "$i18n/utils";
import type { UIKey } from "$i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const ITEMS: ReadonlyArray<UIKey> = ["notfor.1", "notfor.2", "notfor.3", "notfor.4"];
---

<Section label={t("notfor.label")}>
  <p class="max-w-3xl font-display text-3xl font-extrabold tracking-tight text-balance sm:text-4xl">
    {t("notfor.title")}
  </p>
  <ul class="mt-8 grid gap-3 sm:grid-cols-2">
    {
      ITEMS.map((key) => (
        <li class="rounded-xl border border-border bg-card/40 p-5 leading-relaxed text-muted-foreground">
          {t(key)}
        </li>
      ))
    }
  </ul>
</Section>
