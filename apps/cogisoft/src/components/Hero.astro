---
/*
  Hero.astro — the `signals` offer page hero. The SignalField reads a dense
  region out of market noise above; the thesis sits below it.

  Deliberately NOT full-viewport. The previous version used `min-h-svh`, which
  on a tall window left the top 40% empty and pushed the copy to the floor —
  and it hid the next section entirely. The hero now ends above the fold so the
  manifesto peeks and the page reads as continuous.

  Headline caps at 7xl: Sora's full stop is squarish, and at 8xl the coral
  period stopped reading as punctuation and became a block.
*/
import { CONTACT_HREF } from "$lib/config";
import { getLangFromUrl, useTranslations } from "$i18n/utils";
import SignalField from "./SignalField.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="relative flex min-h-[46rem] items-end sm:min-h-[42rem]">
  <SignalField />
  <div class="relative mx-auto w-full max-w-6xl px-6 pt-32 pb-16 sm:pb-20">
    <p class="flex items-center gap-2.5 font-mono text-[11px] uppercase tracking-[0.3em] text-accent">
      <span class="led-indicator" aria-hidden="true"></span>
      {t("hero.eyebrow")}
    </p>
    <h1
      class="mt-5 max-w-3xl font-display text-4xl leading-[1.04] font-extrabold tracking-tight text-balance sm:text-6xl lg:text-7xl"
    >
      {t("hero.title")}<span class="full-stop" aria-hidden="true" />
    </h1>
    <p class="mt-6 max-w-xl text-lg text-muted-foreground">
      {t("hero.sub")}
    </p>
    <div class="mt-9 flex flex-wrap items-center gap-4">
      <a
        href={CONTACT_HREF}
        target="_blank"
        rel="noopener noreferrer"
        class="glow-primary rounded-lg bg-primary px-7 py-3.5 font-semibold text-primary-foreground transition-[filter] hover:brightness-110"
      >
        {t("hero.cta")}
      </a>
      <a
        href="#how"
        class="rounded-lg border border-border px-7 py-3.5 text-muted-foreground transition-colors hover:border-accent/60 hover:text-foreground"
      >
        {t("hero.secondary")} ↓
      </a>
    </div>
  </div>
</section>
