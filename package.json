{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "description": "Vladimir Beliaev's monorepo: shipping apps (apps/), experiments (labs/), non-code workshop (workspace/).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter vvbeliaev dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter vvbeliaev preview",
    "check": "pnpm -r check"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
